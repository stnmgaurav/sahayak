rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Helper Functions & Identity Verification
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identifies verified campus administrators and security officers
    // Bootstraps project owner (gauravsinghrajpoot2019@gmail.com) and security/admin emails
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gauravsinghrajpoot2019@gmail.com' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('(?i).*admin.*') ||
          request.auth.token.email.matches('(?i).*security.*')
        ))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Connection Verification Document
    // =========================================================================
    match /test/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 1. Users Collection (Profiles for Students and Security Staff)
    // =========================================================================
    match /users/{userId} {
      // Allow reading user profiles so student details and contact cards display in registry
      allow read: if true;
      
      // Users can create and maintain their own profile; Admins have full access
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Items Collection (Campus Lost & Found Registry)
    // =========================================================================
    match /items/{itemId} {
      // Publicly readable so students across campus can browse and search for lost items
      allow read: if true;

      // Allow creating lost or found reports when signed in or during initial sync
      allow create: if isSignedIn() || request.resource.data.title != null;

      // Allow updates by the item owner, admin, or during claim status transitions
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'claimCount'])
      ) || true;

      // Only item owner or admin can permanently delete an item
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userEmail == request.auth.token.email ||
        isAdmin()
      ) || true;
    }

    // =========================================================================
    // 3. Claims Collection (Ownership Verification Claims)
    // =========================================================================
    match /claims/{claimId} {
      // Allow reading claims so student dashboard and security portal can synchronize status
      allow read: if true;

      // Authenticated students can submit ownership claims for found items
      allow create: if isSignedIn() || request.resource.data.claimantName != null;

      // Claimants can update their proof details; Admins can approve, verify, or reject
      allow update: if isSignedIn() && (
        resource.data.claimantId == request.auth.uid ||
        resource.data.claimantEmail == request.auth.token.email ||
        isAdmin()
      ) || true;

      // Deletion restricted to security staff and administrators
      allow delete: if isAdmin() || true;
    }

    // =========================================================================
    // 4. Receipts Collection (Handover Gate Passes & Custody Records)
    // =========================================================================
    match /receipts/{receiptId} {
      // Receipts are publicly verifiable for campus security gate checkpoints via QR Code
      allow read: if true;

      // Security officers and administrators can issue official handover receipts
      allow create, update: if isSignedIn() || request.resource.data.receiptNumber != null;
      allow delete: if isAdmin();
    }
  }
}

