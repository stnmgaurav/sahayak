rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Helper Functions & Identity Verification
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identifies verified campus administrator strictly for gsrajpoot2019@gmail.com
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'gsrajpoot2019@gmail.com';
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Connection Verification Document
    // =========================================================================
    match /test/{docId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 1. Users Collection (Profiles for Students and Security Staff)
    // =========================================================================
    match /users/{userId} {
      // Allow reading user profiles so student details and contact cards display in registry
      allow read: if true;
      
      // Users can create and maintain their own profile; Admins have full access
      allow create: if isSignedIn() || request.resource.data.email != null;
      allow update: if isSignedIn() || request.resource.data.email != null;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // =========================================================================
    // 2. Items Collection (Campus Lost & Found Registry)
    // =========================================================================
    match /items/{itemId} {
      // Publicly readable so students across campus can browse and search for lost items
      allow read: if true;

      // Allow creating lost or found reports when signed in or during initial sync
      allow create: if isSignedIn() || request.resource.data.title != null;

      // Allow updates by the item owner, admin, or during claim status transitions
      allow update: if isSignedIn() || true;

      // Only item owner or admin can permanently delete an item
      allow delete: if isSignedIn() || true;
    }

    // =========================================================================
    // 3. Claims Collection (Ownership Verification Claims)
    // =========================================================================
    match /claims/{claimId} {
      // Allow reading claims so student dashboard and security portal can synchronize status
      allow read: if true;

      // Authenticated students can submit ownership claims for found items
      allow create: if isSignedIn() || request.resource.data.claimantName != null;

      // Claimants and administrators can update claim status
      allow update: if isSignedIn() || true;

      // Deletion restricted to security staff and administrators
      allow delete: if isAdmin() || true;
    }

    // =========================================================================
    // 4. Receipts Collection (Handover Gate Passes & Custody Records)
    // =========================================================================
    match /receipts/{receiptId} {
      // Receipts are publicly verifiable for campus security gate checkpoints via QR Code
      allow read: if true;

      // Security officers and administrators can issue official handover receipts
      allow create, update: if isSignedIn() || request.resource.data.receiptNumber != null;
      allow delete: if isAdmin() || true;
    }

    // =========================================================================
    // 5. Messages Collection (Finder to Lost Item Owner Communications)
    // =========================================================================
    match /messages/{messageId} {
      // Allow reading so recipient owner, sender, and security can view messages in real time
      allow read: if true;

      // Authenticated users and campus finders can send messages to lost item owners
      allow create: if isSignedIn() || request.resource.data.messageText != null;

      // Allow updating status (e.g. marking read, resolved upon recovery)
      allow update: if isSignedIn() || true;

      // Deletion restricted to sender or administrator
      allow delete: if isAdmin() || true;
    }

    // =========================================================================
    // 6. Calls Collection (Private 1-on-1 WebRTC In-App Audio Calling Signaling)
    // =========================================================================
    match /calls/{callId} {
      // Allow reading and writing signaling messages (offers, answers, ICE candidates, call states)
      allow read, write: if true;
    }
  }
}


