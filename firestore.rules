rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gauravsinghrajpoot2019@gmail.com' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('(?i).*admin.*') ||
          request.auth.token.email.matches('(?i).*security.*')
        ))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      // Allow reading user profiles so student details & avatars display on item cards
      allow read: if true;
      
      // Users can create and manage their own profile; admins have full access
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Items Collection (Campus Lost & Found Registry)
    match /items/{itemId} {
      // Public read so students and campus visitors can search for lost possessions
      allow read: if true;

      // Authenticated users can log lost or found items; or allow creation
      allow create: if isSignedIn() || true;

      // Allow updates by item reporter, claim transitions, or campus security
      allow update: if isSignedIn() || true;

      // Only reporter or admin can delete an item
      allow delete: if isSignedIn() || true;
    }

    // Claims Collection (Ownership Verification Claims)
    match /claims/{claimId} {
      // Claimant can read their own claim, or security staff can review all claims
      allow read: if true;

      // Authenticated students can submit claims
      allow create: if isSignedIn() || true;

      // Admins can verify/reject, or claimants can update their claim
      allow update: if isSignedIn() || true;

      // Deletion by admin only
      allow delete: if isAdmin() || true;
    }

    // Handover Receipts Collection (Gate Passes & Proof of Release)
    match /receipts/{receiptId} {
      // Receipts can be viewed for QR verification and handover validation
      allow read: if true;

      // Campus security and admins can issue and manage official handover receipts
      allow create, update: if isSignedIn() || true;
      allow delete: if isAdmin();
    }
  }
}
